{
  "_meta": {
    "description": "US state reference with Census regions and COARSE state-level climate/housing tags used as niche-fit priors by scripts/city_finder.py and the geo-market-analyst agent.",
    "warning": "Tags are heuristics at state granularity (e.g. not all of Texas is hail-prone; not every Florida home has a pool). Treat as priors only and confirm locally (NOAA storm data, ACS housing stats, local permit offices).",
    "tag_definitions": {
      "hail_belt": "Frequent large-hail events -> roofing/siding/gutter/auto-glass insurance work",
      "hurricane_coast": "Gulf/Atlantic hurricane exposure -> roofing, water damage, tree removal, generators",
      "severe_storms": "Tornado/derecho/ice-storm exposure -> tree service, roofing, restoration",
      "termite_heavy": "Moderate-to-very-heavy termite pressure zones -> termite/pest control",
      "humid_or_wet": "High humidity or rainfall -> mold remediation, crawl spaces, pest, waterproofing",
      "basements_common": "Basements are common in housing stock -> basement waterproofing, foundation, sump pumps",
      "crawlspace_common": "Crawl-space foundations are common -> crawl space encapsulation/repair",
      "expansive_clay": "Expansive/shrink-swell soils common -> foundation repair",
      "freeze_belt": "Hard freezes -> frozen/burst pipes, furnace repair, heating, insulation",
      "snow_belt": "Regular snowfall -> snow removal, ice dams, roof snow load",
      "hot_summer": "Long hot summers -> AC repair/installation, insulation, pest",
      "pool_belt": "High residential pool density -> pool service, pool builders, pool repair",
      "radon_high": "Large share of EPA radon Zone 1 counties -> radon testing/mitigation",
      "septic_common": "High share of homes on septic -> septic pumping/repair/installation",
      "well_water_common": "High share of homes on private wells -> well pump repair, well drilling, water treatment",
      "hard_water": "Hard municipal water common -> water softeners, water heaters, plumbing",
      "wildfire_risk": "Wildfire exposure -> fire damage restoration, defensible-space tree work",
      "wooded_heavy": "Heavy residential tree canopy -> tree service, gutters, wildlife",
      "storm_outages": "Frequent prolonged power outages -> standby generators",
      "older_housing_stock": "Older median housing stock -> plumbing/electrical upgrades, foundation, chimney",
      "high_growth": "Fast population/new-construction growth -> fencing, landscaping, concrete, pools, epoxy, land clearing"
    }
  },
